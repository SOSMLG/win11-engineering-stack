{
  "telemetry.telemetryLevel": "off",
  "update.mode": "manual",
  "update.showReleaseNotes": false,
  "editor.fontFamily": "JetBrainsMono Nerd Font Mono, Cascadia Mono, Consolas",
  "editor.fontLigatures": true,
  "editor.fontSize": 12,
  "editor.lineHeight": 1.6,
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.formatOnSave": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.git": true,
    "**/Siemens": true,
    "**/MATLAB": true,
    "**/datasets": true,
    "**/.venv": true,
    "**/site-packages": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.git/objects/**": true,
    "**/Siemens/**": true,
    "**/MATLAB/**": true,
    "**/datasets/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "python.languageServer": "None",
  "python.defaultInterpreterPath": "python",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.diagnosticMode": "openFilesOnly",
  "python.analysis.indexing": false,
  "python.analysis.autoImportCompletions": true,
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.lineLength": 100,
  "notebook.formatOnSave.enabled": true,
  "workbench.colorTheme": "Default Dark+",
  "workbench.iconTheme": "vs-seti",
  "workbench.colorCustomizations": {
    "editor.background": "#16181D",
    "editor.foreground": "#D8D3C8",
    "editor.lineHighlightBackground": "#202329",
    "editor.selectionBackground": "#3A352C",
    "editorCursor.foreground": "#E8A33D",
    "editorIndentGuide.background": "#30343B",
    "editorIndentGuide.activeBackground": "#E8A33D",
    "activityBar.activeBorder": "#E8A33D",
    "sideBar.background": "#1B1D22",
    "sideBar.foreground": "#D8D3C8",
    "statusBar.background": "#202329",
    "statusBar.foreground": "#D8D3C8",
    "titleBar.activeBackground": "#16181D",
    "titleBar.activeForeground": "#D8D3C8",
    "terminal.background": "#16181D",
    "terminal.foreground": "#D8D3C8",
    "terminalCursor.foreground": "#E8A33D"
  },
  "workbench.startupEditor": "none",
  "workbench.enableExperiments": false,
  "workbench.tips.enabled": false,
  "workbench.editor.enablePreview": false,
  "window.titleBarStyle": "custom",
  "window.menuBarVisibility": "toggle",
  "security.workspace.trust.enabled": true,
  "security.workspace.trust.untrustedFiles": "prompt",
  "security.workspace.trust.startupPrompt": "always",
  "git.autofetch": false,
  "git.enableSmartCommit": true,
  "git.confirmSync": false
}
