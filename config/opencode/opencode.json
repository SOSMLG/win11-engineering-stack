{
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/auto-coding",
  "providers": {
    "omniroute": {
      "name": "OmniRoute",
      "env": ["OMNIROUTE_API_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      "models": {
        "auto": {
          "name": "OmniRoute Auto",
          "modelID": "auto"
        },
        "auto-coding": {
          "name": "OmniRoute Auto Coding",
          "modelID": "auto/coding"
        },
        "auto-fast": {
          "name": "OmniRoute Auto Fast",
          "modelID": "auto/fast"
        }
      }
    }
  },
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.git/objects/**",
      "**/Siemens/**",
      "**/MATLAB/**",
      "**/datasets/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/site-packages/**"
    ]
  },
  "permissions": [
    { "action": "read", "resource": "*Siemens/*", "effect": "deny" },
    { "action": "read", "resource": "*MATLAB/*", "effect": "deny" },
    { "action": "read", "resource": "*datasets/*", "effect": "deny" },
    { "action": "read", "resource": "*.venv/*", "effect": "deny" },
    { "action": "read", "resource": "*.ssh/*", "effect": "deny" },
    { "action": "read", "resource": "*.kdbx", "effect": "deny" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" }
  ]
}
